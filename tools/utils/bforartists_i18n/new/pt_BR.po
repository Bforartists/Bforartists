msgstr "Método para gerar a coordenada Y do mapa ao longo da curva de perfil."

# BFA - machine translated, please review
msgid "Use Shading"
msgstr "Usar sombreamento"

# BFA - machine translated, please review
msgid "Use shading and shadows on a simple Diffuse material with the Grease Pencil color attribtues"
msgstr "Usa sombreamento e sombras em um material difuso simples com os atributos de cor do Grease Pencil."

# BFA - machine translated, please review
